            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"EXPORT\",\n  \"quantity\": 99999\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/products/1/adjust-stock/",
