            }
          }
        },
        {
          "name": "Test 404 Not Found: Tìm kho không tồn tại",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/warehouses/999999/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "warehouses", "999999", ""]
            }
          }
        },
        {
          "name": "Test 401 Unauthorized: Không có Token khi tạo kho",
