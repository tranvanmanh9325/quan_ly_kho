            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kho Không Phép\",\n  \"code\": \"KHO-NO-AUTH\",\n  \"location\": \"Hà Nội\",\n  \"capacity\": 100\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/warehouses/",
