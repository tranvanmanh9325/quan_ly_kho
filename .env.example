# Application Environment Configuration Template
# Copy this file to .env in the project root and fill in the values for your deployment.

# Debug mode: Set to False in production
DEBUG=True

# Django Secret Key: Cryptographic signing key (MANDATORY).
# In production, generate a secure random string (e.g. python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Allowed Hosts: Comma-separated list of host/domain names that this Django site can serve (MANDATORY).
# Wildcard '*' is disallowed by policy. 'testserver' is automatically appended for automated testing.
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL)
DB_NAME=quan_ly_kho_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
# Set CORS_ALLOW_ALL_ORIGINS=True only for local frontend debugging if strictly necessary.
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated list of trusted origins allowed to perform cross-site HTTP requests
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed Data Configuration (Optional)
# If set, seed_data management command will use this password for the 'admin' user.
# If omitted or empty, seed_data generates a secure one-time password and prints it once.
SEED_ADMIN_PASSWORD=your_seed_admin_password_optional
